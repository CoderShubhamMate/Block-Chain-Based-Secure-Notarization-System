# ============================================================
# BBSNS Desktop Application (Electron) — Environment Variables
# ============================================================
# 🚨 NEVER COMMIT YOUR ACTUAL .env FILE TO GIT.
#    This file is a reference template only.
#
# SETUP:
#   1. Copy: cp .env.example .env
#   2. Replace YOUR_*_HERE placeholders with your values
#
# NOTE: These VITE_ variables are bundled into the Electron renderer.
#       Do NOT include private keys or secrets here.
#       The desktop app connects to the backend API for all sensitive ops.
# ============================================================

# ============================================================
# API ENDPOINTS (Point to your running backend server)
# ============================================================
VITE_BACKEND_URL=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000
VITE_BOOTSTRAP_API_URL=http://localhost:5000

# Remote auth page URL (served by the Web-App)
VITE_AUTH_URL=http://localhost:3000

# ============================================================
# BLOCKCHAIN
# ============================================================
VITE_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
VITE_CHAIN_ID=97
