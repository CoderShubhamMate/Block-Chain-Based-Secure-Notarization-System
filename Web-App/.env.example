# ============================================================
# BBSNS Web Portal (Next.js) — Environment Variables Reference
# ============================================================
# 🚨 NEVER COMMIT YOUR ACTUAL .env.local FILE TO GIT.
#    This file is a reference template only.
#
# SETUP:
#   1. Copy: cp .env.example .env.local
#   2. Replace all YOUR_*_HERE placeholders with real values
#
# NOTE: All NEXT_PUBLIC_ variables are bundled into the browser.
#       Never put secrets in NEXT_PUBLIC_ variables.
# ============================================================


# ============================================================
# API CONNECTION
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:5000


# ============================================================
# DEPLOYED CONTRACT ADDRESSES (NEXT_PUBLIC — visible to browser)
# Get these from contracts/deployments.json after deploying
# ============================================================
NEXT_PUBLIC_NOTARY_REGISTRY_ADDRESS=0xYOUR_NOTARY_REGISTRY_ADDRESS_HERE
NEXT_PUBLIC_DOCUMENT_REGISTRY_ADDRESS=0xYOUR_DOCUMENT_REGISTRY_ADDRESS_HERE
NEXT_PUBLIC_NTKR_CONTRACT_ADDRESS=0xYOUR_NTKR_TOKEN_ADDRESS_HERE
NEXT_PUBLIC_NTK_CONTRACT_ADDRESS=0xYOUR_NTK_TOKEN_ADDRESS_HERE
NEXT_PUBLIC_MULTISIG_ADDRESS=0xYOUR_MULTISIG_ADDRESS_HERE
NEXT_PUBLIC_GENESIS_NFT_ADDRESS=0xYOUR_GENESIS_NFT_ADDRESS_HERE
NEXT_PUBLIC_GENESIS_ACTIVATION_ADDRESS=0xYOUR_GENESIS_ACTIVATION_ADDRESS_HERE


# ============================================================
# VITE-COMPATIBLE FALLBACKS (for Electron remote-auth iframe)
# ============================================================
VITE_NTK_CONTRACT_ADDRESS=0xYOUR_NTK_TOKEN_ADDRESS_HERE
VITE_NTKR_CONTRACT_ADDRESS=0xYOUR_NTKR_TOKEN_ADDRESS_HERE
VITE_MULTISIG_CONTRACT_ADDRESS=0xYOUR_MULTISIG_ADDRESS_HERE
VITE_NOTARY_REGISTRY_ADDRESS=0xYOUR_NOTARY_REGISTRY_ADDRESS_HERE
VITE_DOCUMENT_REGISTRY_ADDRESS=0xYOUR_DOCUMENT_REGISTRY_ADDRESS_HERE
VITE_GENESIS_NFT_ADDRESS=0xYOUR_GENESIS_NFT_ADDRESS_HERE
VITE_GENESIS_ACTIVATION_ADDRESS=0xYOUR_GENESIS_ACTIVATION_ADDRESS_HERE
