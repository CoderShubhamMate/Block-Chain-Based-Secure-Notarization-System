# ============================================================
# BBSNS Backend — Environment Variables Reference
# ============================================================
# 🚨 NEVER COMMIT YOUR ACTUAL .env FILE TO GIT.
#    This file is a reference template only.
#
# SETUP:
#   1. Copy this file: cp .env.example .env
#   2. Replace every YOUR_*_HERE placeholder with your real values
#   3. In production, secrets are fetched from AWS Secrets Manager
#      by SecretService at boot time — do NOT set JWT_SECRET etc. here.
#
# See docs/guides/SETUP.md for full setup instructions.
# ============================================================


# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgres://YOUR_DB_USER_HERE:YOUR_DB_PASSWORD_HERE@localhost:5433/notarydb
DATABASE_URL_TEST=postgres://YOUR_DB_USER_HERE:YOUR_DB_PASSWORD_HERE@localhost:5433/notarydb_test

DB_HOST=localhost
DB_PORT=5433
DB_NAME=notarydb
DB_USER=YOUR_DB_USER_HERE
DB_PASSWORD=YOUR_DB_PASSWORD_HERE


# ============================================================
# APPLICATION
# ============================================================
PORT=5000
NODE_ENV=development

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173


# ============================================================
# BLOCKCHAIN (BNB Chain)
# ============================================================
BLOCKCHAIN_MODE=testnet
RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BNB_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
CHAIN_ID=97

# ⚠️ HIGH RISK — Relayer wallet private key.
# In production, this is managed by AWS KMS and never stored here.
BNB_SYSTEM_PRIVATE_KEY=YOUR_RELAYER_WALLET_PRIVATE_KEY_HERE


# ============================================================
# DEPLOYED SMART CONTRACT ADDRESSES
# (Run contracts deployment script to get these)
# ============================================================
NOTARY_REGISTRY_ADDRESS=0xYOUR_DEPLOYED_NOTARY_REGISTRY_ADDRESS_HERE
DOCUMENT_REGISTRY_ADDRESS=0xYOUR_DEPLOYED_DOCUMENT_REGISTRY_ADDRESS_HERE
NTKR_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_NTKR_TOKEN_ADDRESS_HERE
NTK_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_NTK_TOKEN_ADDRESS_HERE
MULTISIG_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_MULTISIG_ADDRESS_HERE
GENESIS_ACTIVATION_ADDRESS=0xYOUR_DEPLOYED_GENESIS_ACTIVATION_ADDRESS_HERE
GENESIS_NFT_ADDRESS=0xYOUR_DEPLOYED_GENESIS_NFT_ADDRESS_HERE


# ============================================================
# AUTHENTICATION
# ============================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=YOUR_JWT_SECRET_MIN_64_HEX_CHARS_HERE


# ============================================================
# AWS (For production — uses IAM Role in EC2, not static keys)
# ============================================================
AWS_REGION=ap-south-1
AWS_KMS_KEY_ID=alias/YOUR_KMS_KEY_ALIAS_HERE
AWS_S3_BUCKET=YOUR_S3_BUCKET_NAME_HERE
AWS_SECRET_NAME=bbsns/prod/secrets

# Only needed for local dev if NOT on EC2 with IAM Role:
# AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID_HERE
# AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE


# ============================================================
# URLS (Update for your deployment)
# ============================================================
API_BASE_URL=http://localhost:5000
WEB_APP_URL=http://localhost:3000
REMOTE_AUTH_URL=http://localhost:3000


# ============================================================
# EMAIL (Brevo / SendinBlue)
# ============================================================
BREVO_API_KEY=YOUR_BREVO_EMAIL_API_KEY_HERE
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=BBSNS


# ============================================================
# FILE UPLOAD LIMITS
# ============================================================
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
ALLOWED_EXTENSIONS=.pdf,.jpg,.jpeg,.png


# ============================================================
# SYSTEM INTERNALS (usually do not change)
# ============================================================
CONFIG_CHECKSUM_SALT=YOUR_UNIQUE_CHECKSUM_SALT_HERE
REPUTATION_INTERVAL_MS=300000
BBSNS_RUNTIME=web
